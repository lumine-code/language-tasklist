{
  "name": "language-tasklist",
  "author": "lumine-code",
  "description": "Syntax highlighting for tasklist files.",
  "repository": "https://github.com/lumine-code/language-tasklist",
  "bugs": {
    "url": "https://github.com/lumine-code/language-tasklist/issues"
  },
  "keywords": [
    "todo",
    "checklist",
    "gtd",
    "tree-sitter"
  ],
  "version": "1.0.0",
  "license": "MIT",
  "files": [
    "assets",
    "grammars",
    "settings",
    "spec",
    "styles",
    "THIRD_PARTY_NOTICES"
  ],
  "engines": {
    "lumine": "^1.0.0"
  },
  "specPackages": [
    "language-hyperlink",
    "language-todo"
  ],
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.5.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.0"
  },
  "overrides": {
    "eslint@^10.14.0": {
      "minimatch": "11.0.8"
    },
    "@eslint/config-array@0.23.5": {
      "minimatch": "11.0.8"
    }
  }
}
